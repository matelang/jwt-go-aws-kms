{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:monthly"
  ],
  "configMigration": true,
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "packageRules": [
    {
      "description": "The go directive tracks the oldest supported Go release. Raise it by hand when Go drops a release.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "all non-major golang dependencies",
      "groupSlug": "all-minor-patch-golang"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "all github action dependencies",
      "groupSlug": "all-gha"
    }
  ]
}
